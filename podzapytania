:widoki 
create view widok as select p.pID, p.imię, p.nazwisko, e.nazwa as etat, z.nazwa as zaklad
from Pracownicy p
join Etaty e ON p.eID = e.eID
join Zakłady z ON p.zID = z.zID;
a) select zaklad from widok where zaklad like '%ow%'
b) select * from widok where etat = 'ASYSTENT'
c) select top 1 zaklad from widok 
where etat = 'ADIUNKT'
group by zaklad 
order by count(*) desc

alter view widok as
select p.pID, p.imię, p.nazwisko, e.nazwa AS etat, z.nazwa AS zaklad, p.płaca, p.zatrudniony
from Pracownicy p
join Etaty e ON p.eID = e.eID
join Zakłady z ON p.zID = z.zID;
a) select top 1 zaklad from widok group by zaklad order by sum(płaca) desc 


